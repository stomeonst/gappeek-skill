#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import secrets
import stat
import sys
from collections.abc import Mapping, Sequence
from datetime import datetime
from pathlib import Path
from typing import Any, Protocol, cast
from urllib.error import HTTPError, URLError
from urllib.parse import urlparse
from urllib.request import HTTPRedirectHandler, Request, build_opener
from uuid import UUID, uuid4

MAXIMUM_RESPONSE_BYTES = 1_000_000
DEFAULT_API_BASE_URL = "https://temu-ai-pricing-agent-production.up.railway.app"
INSTALLATION_SCHEMA_VERSION = 1


class BridgeError(ValueError):
    pass


class HttpResponse(Protocol):
    def read(self, amount: int = -1) -> bytes: ...

    def __enter__(self) -> HttpResponse: ...

    def __exit__(self, *args: object) -> None: ...


class UrlOpener(Protocol):
    def __call__(self, request: Request, *, timeout: int) -> HttpResponse: ...


class _RejectRedirects(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # An API redirect must never forward an installation credential.
        raise BridgeError("服务地址发生跳转，请停止并联系 GapPeek 支持")


def _open_url(request: Request, *, timeout: int) -> HttpResponse:
    return cast(HttpResponse, build_opener(_RejectRedirects()).open(request, timeout=timeout))


PLATFORMS = ("temu", "tiktok_shop", "amazon", "shopee", "walmart")


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Submit or read a market analysis")
    subcommands = parser.add_subparsers(dest="command", required=True)
    submit = subcommands.add_parser("submit")
    submit.add_argument("--request-id", default=None)
    submit.add_argument(
        "--platform",
        choices=PLATFORMS,
        default=None,
    )
    submit.add_argument("--mode", choices=("single_platform", "cross_platform"), default=None)
    submit.add_argument("--query", default=None)
    submit.add_argument("--research-subject", choices=("product", "category"), default="product")
    submit.add_argument("--current-platform", choices=PLATFORMS, default=None)
    submit.add_argument("--platforms", choices=PLATFORMS, nargs="+", default=None)
    submit.add_argument("--market", action="append", default=None)
    submit.add_argument("--country", default=None)
    submit.add_argument("--category", default=None)
    submit.add_argument("--submarket", default=None)
    status = subcommands.add_parser("status")
    status.add_argument("analysis_id")
    subcommands.add_parser("account-link")
    return parser


def _base_url(environ: Mapping[str, str]) -> str:
    value = (
        environ.get("GAPPEEK_API_BASE_URL", "").strip()
        or DEFAULT_API_BASE_URL
    ).rstrip("/")
    parsed = urlparse(value)
    if parsed.username or parsed.password or not parsed.hostname:
        raise BridgeError("服务地址无效")
    local_hosts = {"localhost", "127.0.0.1", "::1"}
    if parsed.scheme != "https" and not (
        parsed.scheme == "http" and parsed.hostname in local_hosts
    ):
        raise BridgeError("远程服务地址必须使用 HTTPS")
    if parsed.query or parsed.fragment:
        raise BridgeError("服务地址无效")
    return value


def _validate_token(token: str) -> str:
    if not 16 <= len(token) <= 256 or any(character.isspace() for character in token):
        raise BridgeError("访问令牌无效")
    return token


def _configured_token(environ: Mapping[str, str]) -> str | None:
    configured = environ.get("GAPPEEK_API_TOKEN_FILE", "").strip()
    if not configured:
        return None
    path = Path(configured).expanduser()
    if path.is_symlink() or not path.is_file():
        raise BridgeError("访问令牌文件无效")
    mode = stat.S_IMODE(path.stat().st_mode)
    if mode & (stat.S_IRWXG | stat.S_IRWXO):
        raise BridgeError("访问令牌文件权限过宽")
    return _validate_token(path.read_text().strip())


def _config_root(environ: Mapping[str, str]) -> Path:
    configured = environ.get("GAPPEEK_CONFIG_ROOT", "").strip()
    if configured:
        root = Path(configured).expanduser()
    else:
        xdg = environ.get("XDG_CONFIG_HOME", "").strip()
        root = (
            Path(xdg).expanduser() / "gappeek"
            if xdg
            else Path.home() / ".config" / "gappeek"
        )
    if not root.is_absolute():
        raise BridgeError("本地配置目录无效")
    return root


def _read_installation(path: Path, *, base_url: str) -> str | None:
    if path.is_symlink():
        raise BridgeError("本地安装凭证无效")
    if not path.exists():
        return None
    if not path.is_file():
        raise BridgeError("本地安装凭证无效")
    mode = stat.S_IMODE(path.stat().st_mode)
    if mode & (stat.S_IRWXG | stat.S_IRWXO):
        raise BridgeError("本地安装凭证权限过宽")
    try:
        payload = json.loads(path.read_text())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BridgeError("本地安装凭证无效") from error
    if not isinstance(payload, dict) or set(payload) != {
        "schema_version",
        "service_origin",
        "installation_id",
        "access_token",
    }:
        raise BridgeError("本地安装凭证无效")
    if payload["schema_version"] != INSTALLATION_SCHEMA_VERSION:
        raise BridgeError("本地安装凭证版本不受支持")
    if payload["service_origin"] != base_url:
        raise BridgeError("本地安装凭证与服务地址不匹配")
    try:
        UUID(str(payload["installation_id"]))
    except ValueError as error:
        raise BridgeError("本地安装凭证无效") from error
    return _validate_token(str(payload["access_token"]))


def _write_installation(path: Path, payload: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.parent.is_symlink() or not path.parent.is_dir():
        raise BridgeError("本地配置目录无效")
    os.chmod(path.parent, 0o700)
    temporary = path.with_name(f".{path.name}.{secrets.token_hex(6)}.tmp")
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
        encoded = json.dumps(
            payload,
            ensure_ascii=False,
            separators=(",", ":"),
        ).encode()
        written = 0
        while written < len(encoded):
            written += os.write(descriptor, encoded[written:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    except OSError as error:
        raise BridgeError("无法安全保存本地安装凭证") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary.exists():
            temporary.unlink()


def _token(
    environ: Mapping[str, str],
    *,
    base_url: str,
    opener: UrlOpener,
) -> str:
    configured = _configured_token(environ)
    if configured is not None:
        return configured
    path = _config_root(environ) / "installation.json"
    existing = _read_installation(path, base_url=base_url)
    if existing is not None:
        return existing
    installation_id = uuid4()
    registration_secret = secrets.token_urlsafe(32)
    registered = _call(
        url=f"{base_url}/v1/installations",
        token=None,
        method="POST",
        payload={
            "installation_id": str(installation_id),
            "registration_secret": registration_secret,
        },
        opener=opener,
    )
    if registered.get("installation_id") != str(installation_id):
        raise BridgeError("安装登记响应无效")
    if registered.get("status") != "active":
        raise BridgeError("此安装当前不可用")
    token = _validate_token(str(registered.get("access_token", "")))
    _write_installation(
        path,
        {
            "schema_version": INSTALLATION_SCHEMA_VERSION,
            "service_origin": base_url,
            "installation_id": str(installation_id),
            "access_token": token,
        },
    )
    return token


def _call(
    *,
    url: str,
    token: str | None,
    method: str,
    payload: dict[str, object] | None,
    opener: UrlOpener,
    request_id: str | None = None,
) -> dict[str, Any]:
    encoded = (
        json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode()
        if payload is not None
        else None
    )
    headers = {"Accept": "application/json"}
    if request_id is not None:
        headers["Idempotency-Key"] = request_id
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"
    if encoded is not None:
        headers["Content-Type"] = "application/json"
    request = Request(url, data=encoded, headers=headers, method=method)
    try:
        with opener(request, timeout=30) as response:
            content = response.read(MAXIMUM_RESPONSE_BYTES + 1)
    except HTTPError as error:
        messages = {
            401: "安装凭据无效或已撤销，请重新连接 GapPeek",
            402: "积分不足，请前往 https://gappeek.com/zh/pricing 购买积分后再提交",
            403: "账号未绑定或当前无访问权限，请登录 https://gappeek.com/zh/account/devices 完成设备绑定并检查账号状态",
            422: "请检查研究范围并明确目标国家，例如美国男士钱包；本次尚未开始研究，也未扣积分",
            429: "请求过于频繁，请稍后再试，不要连续重试",
            503: "服务暂时不可用，请稍后再试；不要重复提交同一研究",
        }
        raise BridgeError(messages.get(error.code, f"服务请求失败，状态码 {error.code}")) from error
    except (TimeoutError, URLError, OSError) as error:
        raise BridgeError("服务暂时无法连接") from error
    if len(content) > MAXIMUM_RESPONSE_BYTES:
        raise BridgeError("服务响应过大")
    try:
        parsed = json.loads(content)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BridgeError("服务响应无效") from error
    if not isinstance(parsed, dict):
        raise BridgeError("服务响应无效")
    return parsed


def _account_link_result(response: dict[str, Any]) -> dict[str, str]:
    challenge = response.get("challenge")
    expires_at = response.get("expiresAt")
    if (
        not isinstance(challenge, str)
        or not 32 <= len(challenge) <= 256
        or any(character.isspace() for character in challenge)
        or not isinstance(expires_at, str)
        or not expires_at
        or len(expires_at) > 64
    ):
        raise BridgeError("绑定码响应无效")
    try:
        expiration = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
    except ValueError as error:
        raise BridgeError("绑定码响应无效") from error
    if expiration.tzinfo is None or expiration.utcoffset() is None:
        raise BridgeError("绑定码响应无效")
    return {"challenge": challenge, "expiresAt": expires_at}



def _submit_payload(arguments: argparse.Namespace) -> dict[str, object]:
    if arguments.mode == "cross_platform":
        if any(value is not None for value in (
            arguments.platform, arguments.country, arguments.category, arguments.submarket,
        )):
            raise BridgeError("商品查询请使用 --query、唯一 --platforms 和可选 --market 筛选")
        query = (arguments.query or "").strip()
        if not query or len(query) > 120:
            raise BridgeError("商品查询需要 1 至 120 字的 --query 商品或类目名称")
        if not arguments.platforms or len(arguments.platforms) != 1:
            raise BridgeError("请先选择一个目标平台，通过 --platforms 提交；每次仅支持一个平台")
        if arguments.current_platform is not None:
            raise BridgeError("经营背景保留在对话中，请省略 --current-platform，用 --platforms 指定目标平台")
        payload: dict[str, object] = {
            "query_mode": "cross_platform", "query": query,
            "research_subject": getattr(arguments, "research_subject", "product"),
            "target_scope": "available_markets",
            "platforms": arguments.platforms,
        }
        if arguments.market is not None:
            markets: list[dict[str, str]] = []
            for value in arguments.market:
                parts = value.split(":")
                if len(parts) == 2:
                    platform, market_code = parts
                    scope_kind = "country"
                elif len(parts) == 3:
                    platform, scope_kind, market_code = parts
                else:
                    raise BridgeError("市场筛选格式为平台:国家代码，区域使用平台:region:区域代码")
                market_code = market_code.strip().upper()
                if (platform not in PLATFORMS or scope_kind not in {"country", "region"}
                    or len(market_code) != 2 or not market_code.isascii()
                    or not market_code.isalpha()):
                    raise BridgeError("市场筛选的平台、国家或区域代码无效")
                if scope_kind == "region" and (platform, market_code) != ("temu", "EU"):
                    raise BridgeError("当前区域筛选仅接受 temu:region:EU")
                if scope_kind == "country" and market_code == "EU":
                    raise BridgeError("EU 是区域，请使用 temu:region:EU")
                if platform not in arguments.platforms:
                    raise BridgeError("市场筛选与平台筛选冲突")
                market = {
                    "platform": platform, "market_code": market_code, "scope_kind": scope_kind,
                }
                if market in markets:
                    raise BridgeError("市场筛选不能重复")
                markets.append(market)
            payload["markets"] = markets
        return payload
    if any(value is not None for value in (
        arguments.query, arguments.current_platform, arguments.platforms, arguments.market,
    )):
        raise BridgeError("商品查询参数需要 --mode cross_platform")
    if arguments.platform is None:
        raise BridgeError("请先选择一个目标平台，通过 --platform 明确提交统计查询")
    if arguments.platform != "temu" and not (arguments.country or "").strip():
        raise BridgeError("此平台查询需要明确国家，请提供 --country 两位国家代码")
    if arguments.submarket is not None and arguments.category is None:
        raise BridgeError("细分市场需要指定父类目")
    payload = {"category": arguments.category, "submarket": arguments.submarket}
    if arguments.platform is not None:
        payload["platform"] = arguments.platform
    if arguments.country is not None:
        country = arguments.country.strip().upper()
        if len(country) != 2 or not country.isascii() or not country.isalpha():
            raise BridgeError("国家筛选需要两位国家代码")
        if country == "EU":
            raise BridgeError("EU 是区域，商品查询请使用 --mode cross_platform 和 --market temu:region:EU")
        payload.update({
            "market_scope": "regional", "country_code": country,
        })
    return payload


def run(
    argv: Sequence[str],
    *,
    environ: Mapping[str, str],
    opener: UrlOpener,
) -> dict[str, Any]:
    arguments = _parser().parse_args(argv)
    payload = _submit_payload(arguments) if arguments.command == "submit" else None
    request_id = None
    if arguments.command == "submit":
        try:
            request_id = str(UUID(arguments.request_id)) if arguments.request_id else str(uuid4())
        except ValueError as error:
            raise BridgeError("请求编号无效") from error
    base_url = _base_url(environ)
    token = _token(environ, base_url=base_url, opener=opener)
    if arguments.command == "account-link":
        response = _call(
            url=f"{base_url}/v1/installations/binding-challenge",
            token=token,
            method="POST",
            payload={},
            opener=opener,
        )
        return _account_link_result(response)
    if arguments.command == "submit":
        try:
            return _call(
                url=f"{base_url}/v1/analyses",
                token=token,
                method="POST",
                payload=payload,
                opener=opener,
                request_id=request_id,
            )
        except BridgeError as error:
            raise BridgeError(f"{error}；如需重试相同分析，请沿用 --request-id {request_id}") from error
    try:
        analysis_id = UUID(arguments.analysis_id)
    except ValueError as error:
        raise BridgeError("任务编号无效") from error
    return _call(
        url=f"{base_url}/v1/analyses/{analysis_id}",
        token=token,
        method="GET",
        payload=None,
        opener=opener,
    )


def main(argv: Sequence[str] | None = None) -> int:
    try:
        result = run(
            sys.argv[1:] if argv is None else argv,
            environ=os.environ,
            opener=_open_url,
        )
    except BridgeError as error:
        print(str(error), file=sys.stderr)
        return 2
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
